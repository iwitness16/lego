# Copy this file to .env.local and fill in your Supabase project values.
# Find them at: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials (used by the /admin section — simple env-based guard)
ADMIN_EMAIL=admin@legobrickslink.com
ADMIN_PASSWORD=change-me-before-deploy
