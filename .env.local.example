# Copy this file to .env.local and fill in your Supabase project values.
# Find them at: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials (used by the /adminculture section — simple env-based guard)
ADMIN_EMAIL=orders.legobrickslink@gmail.com
ADMIN_PASSWORD=change-me-before-deploy

# Nodemailer — Gmail SMTP with App Password
# How to get an App Password:
#   1. myaccount.google.com → Security → 2-Step Verification (must be ON)
#   2. myaccount.google.com/apppasswords → create a new password
#   3. Paste the 16-char password below (no spaces)
GMAIL_USER=orders.legobrickslink@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here
